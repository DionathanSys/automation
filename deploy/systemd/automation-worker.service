[Unit]
Description=Automation Dramatiq worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@AUTOMATION_USER@
WorkingDirectory=@AUTOMATION_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@AUTOMATION_ROOT@/.venv/bin/dramatiq automation.jobs.worker --processes 1 --threads 1
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
