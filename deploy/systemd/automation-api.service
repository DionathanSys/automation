[Unit]
Description=Automation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@AUTOMATION_USER@
WorkingDirectory=@AUTOMATION_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@AUTOMATION_ROOT@/.venv/bin/python runner.py --serve-api
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
